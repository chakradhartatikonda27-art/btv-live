generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
  GUEST
}

enum InterviewStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum EventType {
  CONFERENCE
  AWARD_CEREMONY
  LIVE_STREAM
  SUMMIT
  WORKSHOP
}

enum EventStatus {
  UPCOMING
  LIVE
  PAST
}

enum CategorySlug {
  BUSINESS_LEADERS
  DOCTORS_HEALTHCARE
  CAs_LEGAL
  INNOVATORS_TECH
  CELEBRITIES
  SPORTS_EVENTS
  REAL_ESTATE
  EDUCATION
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  avatarUrl    String?
  role         Role         @default(GUEST)
  passwordHash String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  submissions  Submission[]
  sessions     Session[]
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        CategorySlug @unique
  description String?
  iconUrl     String?
  coverImage  String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  interviews  Interview[]
  @@map("categories")
}

model Interview {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  summary        String?         @db.Text
  transcript     String?         @db.Text
  thumbnailUrl   String?
  videoUrl       String
  youtubeVideoId String?
  duration       Int?
  viewCount      Int             @default(0)
  featured       Boolean         @default(false)
  status         InterviewStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  guestId        String
  guest          Guest           @relation(fields: [guestId], references: [id])
  tags           Tag[]           @relation("InterviewTags")
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@map("interviews")
}

model Guest {
  id          String      @id @default(cuid())
  fullName    String
  slug        String      @unique
  headline    String?
  bio         String?     @db.Text
  company     String?
  industry    String?
  location    String?
  avatarUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  interviews  Interview[]
  @@map("guests")
}

model Tag {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  interviews Interview[] @relation("InterviewTags")
  @@map("tags")
}

model Event {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String?      @db.Text
  type          EventType
  status        EventStatus  @default(UPCOMING)
  coverImageUrl String?
  venue         String?
  city          String?
  liveStreamUrl String?
  scheduledAt   DateTime
  endedAt       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  gallery       EventMedia[]
  @@index([status, scheduledAt])
  @@map("events")
}

model EventMedia {
  id        String   @id @default(cuid())
  eventId   String
  mediaUrl  String
  mediaType String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@map("event_media")
}

model Submission {
  id           String           @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  profession   String
  company      String?
  city         String?
  industry     String?
  achievements String           @db.Text
  legacyStory  String           @db.Text
  videoLink    String?
  mediaUrls    String[]
  status       SubmissionStatus @default(PENDING)
  reviewNotes  String?          @db.Text
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?
  userId       String?
  user         User?            @relation(fields: [userId], references: [id])
  @@index([status, submittedAt])
  @@map("submissions")
}

model Subscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  @@map("subscribers")
}

model SiteStat {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int
  updatedAt DateTime @updatedAt
  @@map("site_stats")
}

enum TeamRole {
  SUPER_ADMIN
  STATE_HEAD
  DISTRICT_HEAD
  CITY_REPORTER
  CAMERA_PERSON
  VIEWER
}

model State {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  districts District[]
  members   TeamMember[]
  @@map("states")
}

model District {
  id        String     @id @default(cuid())
  name      String
  stateId   String
  state     State      @relation(fields: [stateId], references: [id])
  createdAt DateTime   @default(now())
  cities    City[]
  members   TeamMember[]
  @@map("districts")
}

model City {
  id         String     @id @default(cuid())
  name       String
  districtId String
  district   District   @relation(fields: [districtId], references: [id])
  createdAt  DateTime   @default(now())
  members    TeamMember[]
  @@map("cities")
}

model TeamMember {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         TeamRole  @default(VIEWER)
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  stateId      String?
  districtId   String?
  cityId       String?
  state        State?    @relation(fields: [stateId], references: [id])
  district     District? @relation(fields: [districtId], references: [id])
  city         City?     @relation(fields: [cityId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@map("team_members")
}

model MorningDigest {
  id          String   @id @default(cuid())
  title       String
  date        DateTime @unique
  bulletins   String[] 
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("morning_digests")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleCategory {
  BUSINESS
  TECHNOLOGY
  HEALTHCARE
  FINANCE
  REAL_ESTATE
  EDUCATION
  SPORTS
  ENTERTAINMENT
  POLITICS
  AGRICULTURE
}

model Article {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  summary     String?         @db.Text
  content     String          @db.Text
  coverImage  String?
  status      ArticleStatus   @default(DRAFT)
  category    ArticleCategory @default(BUSINESS)
  tags        String[]
  readTime    Int?
  featured    Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  viewCount   Int             @default(0)

  @@index([status, publishedAt])
  @@index([category])
  @@index([featured])
  @@map("articles")
}

enum OpportunityType {
  JOB
  BUSINESS_LEAD
  TENDER
  FRANCHISE
  PARTNERSHIP
}

enum OpportunityStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

model Opportunity {
  id          String           @id @default(cuid())
  title       String
  type        OpportunityType
  status      OpportunityStatus @default(ACTIVE)
  company     String?
  description String           @db.Text
  location    String?
  city        String?
  state       String?
  salary      String?
  deadline    DateTime?
  applyUrl    String?
  applyEmail  String?
  featured    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type, status])
  @@index([featured])
  @@map("opportunities")
}

enum BusinessCategory {
  RESTAURANT
  HOSPITAL
  CA_FIRM
  TECH_COMPANY
  RETAIL
  REAL_ESTATE
  EDUCATION
  HOTEL
  MANUFACTURING
  TRANSPORT
  LEGAL
  OTHER
}

model Business {
  id          String           @id @default(cuid())
  name        String
  category    BusinessCategory
  description String?          @db.Text
  address     String?
  city        String?
  state       String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  logoUrl     String?
  coverImage  String?
  featured    Boolean          @default(false)
  verified    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
  @@index([city])
  @@index([featured])
  @@map("businesses")
}

model SiteSettings {
  id              String   @id @default(cuid())
  youtubeUrl      String   @default("https://www.youtube.com/@Btvlive-b2b")
  instagramUrl    String   @default("https://www.instagram.com/reel/DbGnjyWk0HY/")
  whatsappNumber  String   @default("+919876543210")
  storiesFeatured Int      @default(500)
  totalViewers    Int      @default(1)
  awardCeremonies Int      @default(50)
  industriesCovered Int    @default(12)
  tickerMessages  String[]
  heroSlides      Json     @default("[]")
  welcomeTitle    String   @default("India's Premier Business & Lifestyle Media Platform")
  welcomeDesc     String   @default("BTV LIVE is a premium media platform dedicated to showcasing the inspiring journeys of entrepreneurs, business leaders, doctors, innovators, and extraordinary individuals.")
  missionText     String   @default("To celebrate excellence, inspire leadership, and preserve the legacies of remarkable individuals who serve as role models for future generations.")
  footerTagline   String   @default("Where Success Goes Live... Legacy Lives Forever.")
  contactEmail    String   @default("btvliveindia@gmail.com")
  contactPhone    String   @default("+91-9885126368")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}
